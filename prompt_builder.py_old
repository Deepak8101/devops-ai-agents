def build_prompt(system_info):

    prompt = f"""
You are a Senior Linux System Administrator.

Analyze the following Linux system.

Hostname:
{system_info["hostname"]}

Disk Usage:
{system_info["disk"]}

Memory:
{system_info["memory"]}

Uptime:
{system_info["uptime"]}

Give:

1. Overall Health
2. Disk Issues
3. Memory Issues
4. Performance Issues
5. Recommendations
"""

    return prompt
